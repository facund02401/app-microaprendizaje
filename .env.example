# Copiar como .env.local y completar. NUNCA commitear .env.local.

# Supabase (públicas por diseño: la seguridad la dan las reglas RLS de la base)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Anthropic (SECRETA: solo en el servidor, sin prefijo NEXT_PUBLIC_)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo de Claude para procesar textos (por defecto claude-opus-5).
# Alternativa más económica: claude-sonnet-5
# CLAUDE_MODEL=claude-opus-5
